    <ProjectReference Include="..\ArcNotes.CloudClient\ArcNotes.CloudClient.csproj" />
    <ProjectReference Include="..\ArcNotes.Infrastructure\ArcNotes.Infrastructure.csproj" />
    <ProjectReference Include="..\ArcNotes.LocalRpc\ArcNotes.LocalRpc.csproj" />
    <ProjectReference Include="..\ArcNotes.Presentation\ArcNotes.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArcNotes.Tests.Ui" />
  </ItemGroup>
</Project>
