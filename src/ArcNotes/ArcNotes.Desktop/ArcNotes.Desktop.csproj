  <Import Project="..\..\..\eng\build\rpc-attach.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcNotes.Desktop</AssemblyName>
    <RootNamespace>ArcNotes.Desktop</RootNamespace>
    <OutputType>Exe</OutputType>
