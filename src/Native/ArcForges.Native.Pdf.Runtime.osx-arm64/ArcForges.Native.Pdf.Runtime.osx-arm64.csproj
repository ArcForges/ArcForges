<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Native.Pdf.Runtime.osx-arm64</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NativePayloadRoot>$(MSBuildThisFileDirectory)../../../artifacts/native-packages/ArcForges.Native.Pdf.Runtime.osx-arm64</NativePayloadRoot>
    <Description>Source-bound osx-arm64 PDFium8044 and ArcPdfNative ABI1.1, bounded rendering/text engine, original legal closure and authenticated production deployment metadata.</Description>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="$(NativePayloadRoot)/**/*" Pack="true" PackagePath="/" />
  </ItemGroup>
  <Target Name="RequireVerifiedNativePayload" BeforeTargets="GenerateNuspec">
    <Error Condition="!Exists('$(NativePayloadRoot)/pdf-runtime-production.json') Or !Exists('$(NativePayloadRoot)/pdfium-production-input.json') Or !Exists('$(NativePayloadRoot)/runtimes/osx-arm64/native/ArcPdfNative.profile.json') Or !Exists('$(NativePayloadRoot)/runtimes/osx-arm64/native/ArcPdfNative.signature.json')" Text="Seal, authenticate and independently verify the exact osx-arm64 PDF producer before packaging. Unproduced RIDs remain inactive." />
  </Target>
</Project>
