<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Native.Pdf</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>ArcForges Pdf native ABI binding: bounded page, text and tile access behind the ContentSandbox helper.</Description>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArcForges.ContentSandbox" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.Tests" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../ArcForges.Native.Abstractions/ArcForges.Native.Abstractions.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
