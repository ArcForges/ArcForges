<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    The arcforges CLI provides typed local Sandbox, Run, resource and Node control using System.CommandLine.
    The host supplies the fixed Node role. The CLI keeps the Native AOT and cold-start requirements.
  -->
  <PropertyGroup>
    <RootNamespace>ArcForges.CommandLine</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Client/ArcForges.Client.csproj" />
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="ArcForges.Contracts.Node" />
    <PackageReference Include="ArcForges.Contracts.Fleet" />
    <PackageReference Include="ArcForges.Contracts.Sandbox.V2" />
    <InternalsVisibleTo Include="ArcForges.Client.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.CloudLink.Tests" />
  </ItemGroup>
</Project>
