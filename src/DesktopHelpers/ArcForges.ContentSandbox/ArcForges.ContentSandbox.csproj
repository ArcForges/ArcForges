<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    The first-party Native AOT content helper host (WP-11.09). It runs only when a parent launches it in its restricted profile, with a closed
    inventory of inherited streams and mappings. It composes the production parsers (WP-13.13); the local PDF parser path is retired (P2-022), so no native PDF library is referenced. The retained five-RID bootstrap is not proof of platform support: the OS-enforced evidence is recorded in the Plan ledger.
  -->
  <Import Project="..\..\..\eng\build\desktop-aot.props" />
  <Import Project="..\..\..\eng\build\desktop-rids.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.ContentSandbox</AssemblyName>
    <RootNamespace>ArcForges.ContentSandbox</RootNamespace>
    <OutputType>Exe</OutputType>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs;Fixture/**/*.cs" />
    <None Remove="Tests/**;Fixture/**" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.Tests" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.HostileFixture" />
    <ProjectReference Include="..\ArcForges.ContentSandbox.Contracts\ArcForges.ContentSandbox.Contracts.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.Foundation\ArcForges.Foundation.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.LocalRpc\ArcForges.LocalRpc.csproj" />
  </ItemGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
