<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>ArcForges.ContentSandbox.Contracts</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Bounded parent-helper protocol and production parser contracts.</Description>
    <AssemblyName>ArcForges.ContentSandbox.Contracts</AssemblyName>
    <RootNamespace>ArcForges.ContentSandbox.Contracts</RootNamespace>
    <IsPackable>true</IsPackable>
    <IsAotCompatible>true</IsAotCompatible>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
    <PackageReference Include="ArcForges.Contracts.LocalRpc.Platform" />
    <PackageReference Include="ArcForges.Contracts.LocalRpc.Sandbox" />
    <ProjectReference Include="../../BuildingBlocks/ArcForges.LocalRpc/ArcForges.LocalRpc.csproj" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.Broker" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.Tests" />
    <InternalsVisibleTo Include="ArcForges.ContentSandbox.HostileFixture" />
  </ItemGroup>
</Project>
