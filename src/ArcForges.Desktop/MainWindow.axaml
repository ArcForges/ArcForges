<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:ArcForges.Desktop"
        x:Class="ArcForges.Desktop.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="ArcForges"
        Width="680" Height="460"
        MinWidth="420" MinHeight="380"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="40" RowDefinitions="Auto,*,Auto" MinHeight="340">
      <StackPanel Spacing="6">
        <TextBlock Text="ARCFORGES" FontSize="14" FontWeight="Bold" />
        <TextBlock Text="Your machine. Your rules." Opacity="0.65" />
      </StackPanel>
      <StackPanel Grid.Row="1" Spacing="16" VerticalAlignment="Center" Margin="0,28">
        <TextBlock x:Name="GreetingText" Text="{Binding Greeting}"
                   FontSize="36" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="A small beginning. A native foundation." TextWrapping="Wrap" Opacity="0.7" />
        <StackPanel Spacing="8" MaxWidth="340" HorizontalAlignment="Left">
          <TextBlock Text="Your name" />
          <TextBox x:Name="NameInput" Text="{Binding Name, Mode=TwoWay}"
                   PlaceholderText="World" MaxLength="80" MinWidth="280"
                   AutomationProperties.Name="Your name" />
          <Button x:Name="SayHelloButton" Content="Say hello" Click="OnSayHello"
                  IsDefault="True" HorizontalAlignment="Left" />
        </StackPanel>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="Hello World preview · C# + Avalonia · Offline"
                 FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
    </Grid>
  </ScrollViewer>
</Window>
