<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Windows Job custody and shared Windows process primitives (AD-0005). Node reopens recorded named Jobs, reattaches their
    completion port, and reads their accounting. Existing holders retain exit records and acknowledgements. The signal helper
    sends console and window signals during graceful stop. The library supplies process creation with explicit inherited handles
    and command-line encoding. Source-generated P/Invoke supports Native AOT and trimming (AD-0003). Windows entry points use
    SupportedOSPlatform("windows"); the pure command-line code is used and tested on every OS.
  -->
  <PropertyGroup>
    <RootNamespace>ArcForges.Node.Platform.Windows</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Node.Platform/ArcForges.Node.Platform.csproj" />
    <ProjectReference Include="../ArcForges.RunSupervisor/Protocol/ArcForges.RunSupervisor.Protocol.csproj" />
    <PackageReference Include="ArcForges.Contracts.Node" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Windows.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.Core.Tests" />
    <InternalsVisibleTo Include="arcforges-run-supervisor" />
  </ItemGroup>
</Project>
