<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.Observability.Desktop</AssemblyName>
    <RootNamespace>ArcForges.Observability.Desktop</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Observability.Desktop</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Desktop diagnostic tiers, local diagnostic store, report approval and revocable telemetry consent.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="ArcForges.Observability.Desktop.Tests" />
    <ProjectReference Include="../ArcForges.Foundation/ArcForges.Foundation.csproj" />
    <ProjectReference Include="../ArcForges.Observability/ArcForges.Observability.csproj" />
  </ItemGroup>
</Project>
