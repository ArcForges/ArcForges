<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.Capabilities</AssemblyName>
    <RootNamespace>ArcForges.Capabilities</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Capabilities</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Per-application identity and explicit in-process typed owner composition.</Description>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Foundation/ArcForges.Foundation.csproj" />
    <Compile Remove="Tests/**/*.cs" />
    <None Remove="Tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
