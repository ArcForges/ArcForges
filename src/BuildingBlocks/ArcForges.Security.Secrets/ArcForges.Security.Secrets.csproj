<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageId>ArcForges.Security.Secrets</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Platform-backed protected secret storage and bounded guarded secret lifetimes.</Description>
    <AssemblyName>ArcForges.Security.Secrets</AssemblyName>
    <RootNamespace>ArcForges.Security.Secrets</RootNamespace>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="Tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
    <Compile Remove="Tests/**/*.cs" />
    <InternalsVisibleTo Include="ArcForges.Security.Secrets.Tests" />
    <ProjectReference Include="../ArcForges.Security/ArcForges.Security.csproj" />
  </ItemGroup>
</Project>
