<Project Sdk="Aspire.AppHost.Sdk/13.4.6">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.Cloud.AppHost</AssemblyName>
    <RootNamespace>ArcForges.Cloud.AppHost</RootNamespace>
    <OutputType>Exe</OutputType>
    <!-- Aspire injects Dashboard/DCP packages for the build host, so one cross-host lock is impossible. -->
    <NuGetLockFilePath>packages.$(NETCoreSdkRuntimeIdentifier).lock.json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ArcForges.Cloud.Host\ArcForges.Cloud.Host.csproj" IsAspireProjectResource="true" />
  </ItemGroup>
</Project>
