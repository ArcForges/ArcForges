<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Linux custody recovery for recorded transient systemd user units in arcforges.slice (AD-0005). The user manager supplies
    unit observation, freeze and stop. Exit records are read from disk and resource usage comes from the cgroup. Existing
    units can still call exec-launch, exec-stop and exit-record. The guard supervises recorded units while the node is down.
    Native access uses source-generated libc P/Invoke.
    The library is part of the Native AOT arcforges executable (AD-0003), so it is AOT-
    and trim-compatible. Every type that calls Linux is marked SupportedOSPlatform("linux"); the pure parts are tested on every OS.
  -->
  <PropertyGroup>
    <RootNamespace>ArcForges.Node.Platform.Linux</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Node.Platform/ArcForges.Node.Platform.csproj" />
    <ProjectReference Include="../ArcForges.RunSupervisor/Protocol/ArcForges.RunSupervisor.Protocol.csproj" />
    <PackageReference Include="ArcForges.Contracts.Node" />
    <PackageReference Include="Tmds.DBus.Protocol" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Linux.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.Core.Tests" />
    <InternalsVisibleTo Include="arcforges-run-supervisor" />
    <InternalsVisibleTo Include="ArcForges.ClosedLoop.Tests" />
  </ItemGroup>
</Project>
