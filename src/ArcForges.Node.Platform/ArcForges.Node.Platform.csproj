<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Platform-neutral MXC profile admission, host and Run resource observation and control, and the Node heartbeat.
    The library is AOT- and trim-compatible.
  -->
  <PropertyGroup>
    <RootNamespace>ArcForges.Node.Platform</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArcForges.Node.Core" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Windows" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Linux" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Linux.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.Platform.Windows.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../eng/mxc/profiles/windows-process-executor-v1.qualification.json;../../eng/mxc/profiles/linux-bubblewrap-sdk-v1.qualification.json"
                      LogicalName="ArcForges.Mxc.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
