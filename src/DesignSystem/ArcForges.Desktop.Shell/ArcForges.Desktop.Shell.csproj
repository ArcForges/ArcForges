<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcForges.Desktop.Shell</AssemblyName>
    <RootNamespace>ArcForges.Desktop.Shell</RootNamespace>
    <IsPackable>true</IsPackable>
    <PackageId>ArcForges.Desktop.Shell</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Framework-neutral desktop shell mechanisms: window and panel layout, commands, settings, attention, error presentation, lifecycle, accessibility and localisation contracts.</Description>
  </PropertyGroup>
  <PropertyGroup>
    <LicenceBoundary>AGPL</LicenceBoundary>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
    <EmbeddedResource Remove="Tests/**" />
    <None Remove="Tests/**" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../../NOTICE.md" Pack="true" PackagePath="/" />
    <ProjectReference Include="../ArcForges.DesignSystem/ArcForges.DesignSystem.csproj" />
    <ProjectReference Include="../../BuildingBlocks/ArcForges.Capabilities/ArcForges.Capabilities.csproj" />
    <ProjectReference Include="../../BuildingBlocks/ArcForges.Foundation/ArcForges.Foundation.csproj" />
  </ItemGroup>
</Project>
