<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>arcforges-run-supervisor</AssemblyName>
    <RootNamespace>ArcForges.RunSupervisor</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Protocol/**/*.cs" />
    <ProjectReference Include="Protocol/ArcForges.RunSupervisor.Protocol.csproj" />
    <ProjectReference Include="../ArcForges.Node.Platform.Linux/ArcForges.Node.Platform.Linux.csproj" />
    <ProjectReference Include="../ArcForges.Node.Platform.Windows/ArcForges.Node.Platform.Windows.csproj" />
    <PackageReference Include="Microsoft.Mxc.Sdk" />
  </ItemGroup>
</Project>
