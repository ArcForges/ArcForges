<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    The node's link to its center (AF-CTR-04 part N1; architecture 02 section 1, 10 section 3): the node credential in the node's
    secret store, the node key (CNG on Windows, a 0600 PKCS#8 file on Linux, file-backed under test mode), the center's key sets, the
    refresh of the node credential, ReportNodeInfo and SignOutNode, over binary gRPC-Web through the one HTTP seam (CenterHttpClient).
    Library of the AOT executable arcforges (AD-0003), so it is AOT- and trim-compatible.
  -->
  <PropertyGroup>
    <RootNamespace>ArcForges.Node.CloudLink</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../ArcForges.Node.Core/ArcForges.Node.Core.csproj" />
    <PackageReference Include="ArcForges.Contracts.Fleet" />
    <PackageReference Include="ArcForges.Contracts.Node" />
    <!-- The node's graph carries the DesktopPlatform 1.0.0-ci.141.1 exact Contracts.Foundation constraints (NU1608; recorded). -->
    <PackageReference Include="ArcForges.Contracts.Foundation" NoWarn="NU1608" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Grpc.Net.Client.Web" />
    <InternalsVisibleTo Include="ArcForges.Node.Api" />
    <InternalsVisibleTo Include="ArcForges.Node.CloudLink.Tests" />
    <InternalsVisibleTo Include="ArcForges.ClosedLoop.Tests" />
    <InternalsVisibleTo Include="ArcForges.Node.Core.Tests" />
    <InternalsVisibleTo Include="ArcForges.Repository.Tests" />
    <InternalsVisibleTo Include="ArcForges.OsSecretStoreTier" />
  </ItemGroup>
</Project>
