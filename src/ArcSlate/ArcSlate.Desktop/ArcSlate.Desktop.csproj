<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\..\eng\build\desktop-aot.props" />
  <Import Project="..\..\..\eng\build\desktop-rids.props" />
  <Import Project="..\..\..\eng\build\rpc-attach.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ArcSlate.Desktop</AssemblyName>
    <RootNamespace>ArcSlate.Desktop</RootNamespace>
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>full</TrimMode>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\ArcForges.Observability\ArcForges.Observability.csproj" />
    <ProjectReference Include="..\ArcSlate.Application\ArcSlate.Application.csproj" />
    <ProjectReference Include="..\ArcSlate.CloudClient\ArcSlate.CloudClient.csproj" />
    <ProjectReference Include="..\ArcSlate.Infrastructure\ArcSlate.Infrastructure.csproj" />
    <ProjectReference Include="..\ArcSlate.LocalRpc\ArcSlate.LocalRpc.csproj" />
    <ProjectReference Include="..\ArcSlate.Presentation\ArcSlate.Presentation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="ArcSlate.Tests.Ui" />
  </ItemGroup>
</Project>
