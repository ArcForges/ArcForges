<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!--
    Test projects are Microsoft Testing Platform executables (xUnit v3). Suites are selected by
    traits (16 section 4) through eng/test.ps1 and eng/test.sh; see eng/test-suites.conf.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <!--
    The runtime tripwire of the OS secret-store guard (16-testing-strategy section 1, item 2): every test project, the OS secret-store
    tier's included, denies the real OS secret stores through its runtime configuration. DesktopPlatform's adapters then refuse
    Credential Manager and the user's Secret Service before any OS call unless ARCFORGES_OS_SECRET_STORE_TESTS=1 is set, which only the
    tier's runner and hosted job do. Production projects (src/, tools/) never set it; ArcForges.Repository.Tests checks both in the
    built runtime configurations.
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="ArcForges.Security.Secrets.DenyOsStores" Value="true" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
    <!-- Recorded processes are identified by ID and creation, never by ID alone (IDs are reused). -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/ProcessIdentity.cs" Link="Shared/ProcessIdentity.cs" />
    <!-- The systemd user manager of the Linux tests: availability, delegation, and the slice and unit cleanup of 16 section 4. -->
    <Compile Include="$(MSBuildThisFileDirectory)Shared/SystemdTestEnvironment.cs" Link="Shared/SystemdTestEnvironment.cs" />
  </ItemGroup>
</Project>
