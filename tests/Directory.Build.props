<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <!--
    Test projects are Microsoft Testing Platform executables (xUnit v3). Suites are selected by
    traits (16 section 4) through eng/test.ps1 and eng/test.sh; see eng/test-suites.conf.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3.mtp-v2" />
    <Using Include="Xunit" />
  </ItemGroup>
</Project>
