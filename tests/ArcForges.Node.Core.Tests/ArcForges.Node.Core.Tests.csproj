<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Unit and node-component tests of src/ArcForges.Node.Core and src/ArcForges.Node.Api (16-testing-strategy sections 1 and 4):
    lifecycle, cursors, configuration and log redaction as units; the journal, command processor, NodeService, NodeEventService and
    TaskService (with the real Windows execution platform, real holders and arcforges-testload workloads) with their real neighbours: a real SQLite store, a real LocalRpc server on a real named pipe or Unix
    socket and the real client library. The node data key lives in the isolated secret-store backend (16-testing-strategy section 2;
    tests/Shared/IsolatedSecretStore.cs), never in a real OS secret store; otherwise no fakes.
  -->
  <PropertyGroup>
    <!-- ProcessInspection reads a holder's command line through source-generated P/Invoke. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fixtures report leftovers to the test (not from their disposal, which would hide the test's own failure). -->
    <Compile Include="../Shared/Leftovers.cs" Link="Shared/Leftovers.cs" />
    <!-- Tests run in parallel: a node's fixture finds its own holders by the attempt names on their command lines. -->
    <Compile Include="../Shared/ProcessInspection.cs" Link="Shared/ProcessInspection.cs" />
    <!-- The isolated secret-store backend of 16-testing-strategy section 2 (in-process nodes; the real OS stores are the tier's alone). -->
    <Compile Include="../Shared/IsolatedSecretStore.cs" Link="Shared/IsolatedSecretStore.cs" />
    <ProjectReference Include="../../src/ArcForges.Node.Api/ArcForges.Node.Api.csproj" />
    <ProjectReference Include="../../src/ArcForges.Client/ArcForges.Client.csproj" />
    <!-- The node starts its helper roles from the arcforges executable; attempts run the deterministic arcforges-testload workloads. -->
    <ProjectReference Include="../../src/ArcForges.Host/ArcForges.Host.csproj" />
    <ProjectReference Include="../../tools/ArcForges.TestLoad/ArcForges.TestLoad.csproj" />
    <!-- The node's graph carries the DesktopPlatform 1.0.0-ci.141.1 exact Contracts.Foundation constraints (NU1608; recorded). -->
    <PackageReference Include="ArcForges.Contracts.Foundation" NoWarn="NU1608" />
    <!-- Property-based and model-based tests (16-testing-strategy; AD-0016). -->
    <PackageReference Include="CsCheck" />
    <Compile Include="../Shared/PropertyRuns.cs" Link="Shared/PropertyRuns.cs" />
  </ItemGroup>
</Project>
