<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    ArcForges's OS secret-store integration tier (16-testing-strategy section 1): the node data key through NodeDataKeyRing and the node
    credential through the cloud link's credential store against the real Windows Credential Manager, and the node key in the real CNG
    user key store (AF-CTR-04), minimal and sequential, under the tier fixture's limits (one fixture and budget per test class). The only tests in this repository
    that reach a real OS secret store. The project name is outside tests/*/*.Tests.csproj, so no suite of eng/test-suites.conf, no
    host verification step and no other workflow selects it (ArcForges.Repository.Tests checks this); it runs only through
    .github/workflows/os-secret-store-tier.yml or eng/os_secret_store_tier.py, with ARCFORGES_OS_SECRET_STORE_TESTS=1 for that run
    alone. Like every test project it sets the tripwire switch (tests/Directory.Build.props); the opt-in lifts it for this run only.
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/ArcForges.Node.Store/ArcForges.Node.Store.csproj" />
    <!-- AF-CTR-04 N1-13/N1-14: the CNG node key and the node credential through the cloud link's production paths. -->
    <ProjectReference Include="../../src/ArcForges.Node.CloudLink/ArcForges.Node.CloudLink.csproj" />
  </ItemGroup>
</Project>
