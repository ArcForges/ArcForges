<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Tests of src/ArcForges.Node.CloudLink and the node's AccountService (AF-CTR-04 part N1; 16-testing-strategy sections 1 and 4): the center
    URL, the node key and its proof, the credential store, the refresh scheduler, the key sets, the one HTTP seam and the refusal mapping,
    with a real node in the test process where the local endpoint is involved.
    This project holds the one fake the task allows here: FakeCenter (the Plan's AF-CTR-04 fakes_allowed: "FakeCenter (the center, in node
    tests only; conformance-tested against exchanges captured from a real center)"), an in-process stand-in for the center over a real
    loopback HTTP listener, pinned by the vendored REAL captures in Fixtures/center-exchanges (FakeCenterConformanceTests). Secrets live in
    the isolated backend (tests/Shared/IsolatedSecretStore.cs); otherwise no fakes.
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="../Shared/IsolatedSecretStore.cs" Link="Shared/IsolatedSecretStore.cs" />
    <Compile Include="../Shared/Leftovers.cs" Link="Shared/Leftovers.cs" />
    <ProjectReference Include="../../src/ArcForges.Node.Api/ArcForges.Node.Api.csproj" />
    <ProjectReference Include="../../src/ArcForges.Client/ArcForges.Client.csproj" />
    <!-- AF-CTR-05 N2b (RoutedNodeTests, N2-22): a routed run executes, so the node starts its helper roles from the arcforges executable and
         attempts run the deterministic arcforges-testload workloads, as in ArcForges.Node.Core.Tests. -->
    <ProjectReference Include="../../src/ArcForges.Host/ArcForges.Host.csproj" />
    <ProjectReference Include="../../tools/ArcForges.TestLoad/ArcForges.TestLoad.csproj" />
    <!-- The node's graph carries the DesktopPlatform 1.0.0-ci.141.1 exact Contracts.Foundation constraints (NU1608; recorded). -->
    <PackageReference Include="ArcForges.Contracts.Foundation" NoWarn="NU1608" />
    <None Include="Fixtures/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
