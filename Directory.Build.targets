<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <KnownWebAssemblySdkPack Remove="Microsoft.NET.Sdk.WebAssembly.Pack" />
    <KnownWebAssemblySdkPack
      Include="Microsoft.NET.Sdk.WebAssembly.Pack"
      TargetFramework="net10.0"
      WebAssemblySdkPackVersion="10.0.11" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ArcForgesDeployWindowsNativeRuntime)' == 'true'">
    <ArcForgesWindowsNativeRuntimeDirectory>$(MSBuildThisFileDirectory)artifacts\msbuild\native\win-x64\$(Configuration)\</ArcForgesWindowsNativeRuntimeDirectory>
  </PropertyGroup>
  <Target
    Name="CollectArcForgesWindowsNativeRuntime"
    BeforeTargets="AssignTargetPaths"
    Condition="'$(ArcForgesDeployWindowsNativeRuntime)' == 'true' and $([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_ArcForgesWindowsNativeRuntime Include="$(ArcForgesWindowsNativeRuntimeDirectory)*.dll" />
      <Content Include="@(_ArcForgesWindowsNativeRuntime)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
    <Error
      Condition="'@(_ArcForgesWindowsNativeRuntime)' == ''"
      Text="ArcForges native runtime was not built at '$(ArcForgesWindowsNativeRuntimeDirectory)'. Build the Windows solution so its native project dependencies run first." />
  </Target>
  <!--
    The managed taxonomy is run one category at a time, once per pr-gate slice. A single category leaves most
    test assemblies with nothing to run, and Microsoft.Testing.Platform reports "zero tests ran" as exit
    code 8 — which is correct for that assembly but is not a failure of the slice. The taxonomy run therefore
    tolerates code 8 per assembly.

    That tolerance would hide a slice that ran nothing at all, so it never stands alone: each pr-gate slice
    asserts separately that the run reported a non-zero total, and exit code 8 is the only code ignored, so a
    real test failure still fails the job.
  -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(ArcForgesManagedTestTaxonomy)' == 'true'">
    <TestingPlatformCommandLineArguments>$(TestingPlatformCommandLineArguments) --ignore-exit-code 8</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <Import Project="eng\build\NoInlineVersions.targets" />
</Project>
