<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!-- Android production uses MAUI Mono AOT. CoreCLR Native AOT is not the product baseline. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(TargetFrameworkIdentifier)' == 'android'">
    <RunAOTCompilation>true</RunAOTCompilation>
  </PropertyGroup>
</Project>
