<Project>
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!--
    Imported by the seven src/Contracts projects only. Contract assemblies are wave 1
    warnings-as-errors and must stay AOT/trim clean because they ship inside every Native AOT
    desktop head. The STJ / Refit / StreamJsonRpc source-generator switches and the
    reflection-prohibition diagnostics that implementation-repository-layout.md §13 assigns to
    this file are filled in by Step 02, when the contract types themselves land.
  -->
  <PropertyGroup>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Step 02's Required Inputs table names these four assemblies as the consumers of contract internals.
    The partitioned `JsonSerializerContext` types it introduces are internal, and the source-generation
    coverage, old-vs-new compatibility and generated-only purity assertions all have to reach them.
    Declaring the grant here gives all seven contract projects the identical set from one place; the
    seven-project import boundary is itself pinned by
    `RepositoryPolicyTests.LayeredBuildPropertyFilesAreImportedByExactlyTheirDeclaredHosts`, and the
    emitted attributes are pinned by
    `RepositoryPolicyTests.ContractAssembliesGrantInternalsToTheContractTestProjects`.

    The set is exactly four. Step 02's source-generation coverage assertion belongs to
    `ArcForges.Tests.ContractCompatibilityTests`, which is already listed; `ArcForges.Tests.ContractSchemaTests`
    stays scoped to generated JSON Schema and golden-file validation and needs no access to contract internals.
    Do not add a fifth grantee unless an authoritative document or the code proves it unavoidable.
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="ArcForges.Tests.ContractCompatibilityTests" />
    <InternalsVisibleTo Include="ArcForges.Tests.ArchitectureTests" />
    <InternalsVisibleTo Include="ArcForges.Tests.PublicApiContractTests" />
    <InternalsVisibleTo Include="ArcForges.Tests.RealtimeReconnectTests" />
  </ItemGroup>
</Project>
