  "routeParameters": {
    "namePrefix": "http.route.param.",
    "kind": "guid-32",
    "slotRule": "The slot name must be declared by a route template registered through RouteTemplateSet.Create (a lower-case word of at most 32 letters and digits, starting with a letter, that is not a known-sensitive field name); the value is an opaque identifier, never a name or path. A field whose slot name no registered template declares is removed."
  },
  "metricLabels": {
    "pointLabels": [
      "service.name"
    ],
    "scopeAttributes": [
      "application.id",
      "instance.id",
      "build.id",
      "deployment.environment"
    ],
    "unboundedIdentifiersAreNeverLabels": true,
    "pointLabelRule": "A metric point carries only the labels in pointLabels, each with a value from its closed vocabulary; every other dimension, including every identifier, is a span or structured-event field and is removed from a metric point by MetricLabelPolicy.ScrubLabels.",
    "maximumSeriesPerInstrument": 9
  },
  "redaction": {
    "exportRule": "A field is exported only if its name is in dimensions or routeParameters, is not a known-sensitive name, and its value has exactly the kind recorded for it. Every other field is removed, including every header, cookie, token, prompt, note, path, raw URL and exception text.",
    "operationNameRule": "A span or span-event name is exported only as dot-separated ASCII words (at most 80 characters); anything else is exported as 'redacted'. Status descriptions, links and baggage are never exported.",
    "sensitiveFieldNames": {
      "exact": [
        "authorization",
        "proxy-authorization",
        "cookie",
        "set-cookie",
        "x-api-key",
        "api-key",
        "x-auth-token",
        "x-csrf-token",
        "x-amz-security-token"
      ],
      "words": [
        "auth",
        "authorization",
        "bearer",
        "byok",
        "cookie",
        "cookies",
        "credential",
        "credentials",
        "jwt",
        "otp",
        "passkey",
        "passkeys",
        "passwd",
        "password",
        "passwords",
        "secret",
        "secrets",
        "token",
        "tokens",
        "header",
        "headers",
        "prompt",
        "prompts",
        "completion",
        "completions",
        "message",
        "messages",
        "content",
        "contents",
        "body",
        "payload",
        "payloads",
        "text",
        "note",
        "notes",
        "annotation",
        "annotations",
        "attachment",
        "attachments",
        "document",
        "documents",
        "file",
        "files",
        "filename",
        "filepath",
        "path",
        "paths",
        "directory",
        "folder",
        "url",
        "uri",
        "query",
        "querystring",
        "exception",
        "stacktrace",
        "stack"
      ],
      "wordSequences": [
        [
          "api",
          "key"
        ],
        [
          "private",
          "key"
        ],
        [
          "access",
          "key"
        ],
        [
          "signing",
          "key"
        ],
        [
          "one",
          "time",
          "code"
        ],
        [
          "raw",
          "sync"
        ]
      ]
    }
  },
  "sampling": {
    "head": {
      "configurablePer": [
        "signal",
        "route"
      ],
      "strategy": "parent-based trace-identifier ratio: a root span is selected when its trace identifier falls under its ratio and a child span follows the sampled flag of its parent; every span is recorded so that an unselected trace can still be promoted",
      "ratioRange": [
        0,
        1
      ],
      "precedence": [
        "route",
        "signal",
        "default"
      ],
      "defaultRatio": null
    },
    "diagnosticBuffer": {
      "defaultBytes": 8388608,
      "hardLimitBytes": 16777216,
      "minimumBytes": 1024,
      "perTraceRetentionSeconds": 30,
      "maximumClosedTraces": 1024,
      "contents": "finished spans of unselected traces, already copied through the scrubbing processor",
      "accounting": "a deterministic cost model charged for every retained span, trace entry, promotion state and closed-trace marker; it is not a measurement of process memory",
      "evictionOrder": [
        "closed-trace markers",
        "whole held traces, oldest first",
        "oldest spans of the trace being extended",
        "promotion state, oldest first"
      ]
    },
    "promotion": {
      "errorAndSlow": "spans-still-recorded-only",
      "everyErrorTraceRetained": false,
      "slowSpanThresholdMs": null
    },
    "errorFacts": {
      "recordedForEverySpanWithErrorStatus": true,
      "independentOfSampling": true,
      "eventName": "trace.error",
      "counter": "arcf_span_error_count",
      "fields": "the reviewed fields of the scrubbed span plus the application, instance, build and environment identity"
    },
    "consent": {
      "gate": "ITelemetryConsent, read live on every span",
      "whenAbsent": "no span is exported or held, no error fact or instrument measurement is produced, and held spans are purged; statistics stay readable locally",
      "cloudHosts": "TelemetryConsent.NotRequired"
    },
    "loss": {
      "countedAndVisible": true,
      "counters": [
        "arcf_trace_span_head_sampled",
        "arcf_trace_span_promoted",
        "arcf_trace_span_lost_overflow",
        "arcf_trace_span_lost_late",
        "arcf_trace_span_lost_oversize",
        "arcf_trace_error_span_not_retained"
      ],
      "gauges": [
        "arcf_trace_buffer_bytes"
      ],
      "pointLabels": "none"
    },
    "lossIsCountedAndVisible": true
  },
  "retention": {
    "signalClassPosture": {
      "metrics": "longest-aggregated",
      "traces": "short-sampled",
      "logs": "short-to-medium"
    },
    "traceBufferSeconds": 30,
    "durationsByClassAndEnvironment": null,
    "productionAndNonProductionBudgetedSeparately": true,
    "auditRetentionIsIndependent": true,
    "enforcedByLibrary": "only the in-process trace buffer window; retention at a telemetry backend is deployment configuration"
  },
  "notFixedByDesign": [
    "sampling.head.defaultRatio",
    "sampling.promotion.slowSpanThresholdMs",
    "retention.durationsByClassAndEnvironment"
  ]
}
